#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
skill_root="$repo_root/SCI-PS-SKILL/sci-ps-skill_v5.0"
venv="$repo_root/.venv"

cd "$repo_root"

echo "[setup] Preparing Python virtual environment"
if [[ ! -x "$venv/bin/python" ]]; then
  time python3 -m venv "$venv"
fi

echo "[setup] Installing Python dependencies"
time "$venv/bin/python" -m pip install \
  --disable-pip-version-check \
  --requirement "$skill_root/requirements.txt"

profile_marker="# sci-ai-skill orb virtual environment"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ "\${PWD}" == "$repo_root" && -f "$venv/bin/activate" ]]; then
  source "$venv/bin/activate"
fi
EOF
fi

echo "[setup] Verifying imports"
"$venv/bin/python" -c 'import jsonschema; from PIL import Image; from mcp.server.fastmcp import FastMCP'
echo "[setup] Ready"
